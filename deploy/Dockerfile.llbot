# Build recipe for an independent installation; source runtime matches deployed llbot.js.
FROM node:24-bookworm-slim
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app/llbot
COPY runtime/ /app/llbot/
ENTRYPOINT ["node", "--enable-source-maps", "llbot.js"]
CMD ["--pmhq-host=pmhq", "--pmhq-port=13000", "--pmhq-legacy"]
